<Window x:Class="FeatherRebornLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Feather Reborn Launcher"
        Width="1120" Height="720"
        MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" Background="{StaticResource BgBrush}"
        ResizeMode="NoResize"
        FontFamily="Segoe UI Variable Display, Microsoft YaHei UI"
        Foreground="{StaticResource TextBrush}"
        Icon="Assets/feather.ico">
  <Border x:Name="RootBorder" CornerRadius="18" Background="{StaticResource BgBrush}"
          BorderBrush="#252B36" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="52" />
        <RowDefinition Height="*" />
        <RowDefinition Height="28" />
      </Grid.RowDefinitions>

      <!-- Title bar -->
      <Grid Grid.Row="0" Background="#0E1118" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
          <Image Source="Assets/feather_icon.png" Width="16" Height="24" Stretch="Uniform" />
          <TextBlock Text="FEATHER" FontSize="12" FontWeight="Bold" Margin="9,0,0,0" VerticalAlignment="Center" />
          <TextBlock Text="CLIENT" FontSize="12" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"
                     Margin="5,0,0,0" VerticalAlignment="Center" />
          <Border Background="#2A1518" CornerRadius="5" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="REBORN LAUNCHER" FontSize="8.5" Foreground="#FF8B8D" FontWeight="SemiBold" />
          </Border>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
          <Button Content="—" Style="{StaticResource WindowButton}" Click="Minimize_Click" />
          <Button Content="✕" Style="{StaticResource WindowButton}" Click="Close_Click" />
        </StackPanel>
      </Grid>

      <!-- Main -->
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="220" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="#0D1017" BorderBrush="#1E2430" BorderThickness="0,0,1,0">
          <Grid Margin="18,22,18,16">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel>
              <Image Source="Assets/feather_icon.png" Width="32" Height="48" HorizontalAlignment="Left" Stretch="Uniform" />
              <TextBlock Text="FEATHER" FontSize="18" FontWeight="Bold" Margin="0,12,0,0" />
              <TextBlock Text="REBORN" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
              <TextBlock Text="1.8.9 · Launcher" Style="{StaticResource MutedText}" Margin="0,7,0,0" />
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="0,30,0,0">
              <RadioButton x:Name="NavHome" GroupName="Nav" Style="{StaticResource NavButton}" IsChecked="True"
                           Tag="home" Checked="Nav_Checked" Content="⌂   启动" />
              <RadioButton x:Name="NavMods" GroupName="Nav" Style="{StaticResource NavButton}"
                           Tag="mods" Checked="Nav_Checked" Content="▦   模组" />
              <RadioButton x:Name="NavSettings" GroupName="Nav" Style="{StaticResource NavButton}"
                           Tag="settings" Checked="Nav_Checked" Content="⚙   设置" />
              <RadioButton x:Name="NavLogs" GroupName="Nav" Style="{StaticResource NavButton}"
                           Tag="logs" Checked="Nav_Checked" Content="▤   日志" />
            </StackPanel>

            <StackPanel Grid.Row="2">
              <Border Background="#111620" BorderBrush="#222938" BorderThickness="1" CornerRadius="12" Padding="12">
                <StackPanel>
                  <TextBlock Text="游戏状态" Style="{StaticResource MutedText}" />
                  <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Ellipse x:Name="SidebarStatusDot" Width="7" Height="7" Fill="{StaticResource SuccessBrush}"
                             VerticalAlignment="Center" />
                    <TextBlock x:Name="SidebarStatusText" Text="就绪" FontSize="12" Margin="7,0,0,0" />
                  </StackPanel>
                </StackPanel>
              </Border>
              <TextBlock x:Name="GamePathText" Style="{StaticResource MutedText}" Margin="2,10,0,0"
                         TextTrimming="CharacterEllipsis" ToolTipService.ShowDuration="30000" />
            </StackPanel>
          </Grid>
        </Border>

        <!-- Content -->
        <Grid Grid.Column="1" Background="{StaticResource BgBrush}">
          <!-- Home -->
          <Grid x:Name="HomePage">
            <Grid.Background>
              <RadialGradientBrush Center="0.72,0.12" GradientOrigin="0.72,0.12" RadiusX="0.9" RadiusY="0.95">
                <GradientStop Color="#172235" Offset="0" />
                <GradientStop Color="#0B0D12" Offset="1" />
              </RadialGradientBrush>
            </Grid.Background>
            <Image Source="Assets/feather_icon.png" Opacity="0.055" Width="520" Stretch="Uniform"
                   HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-110,0"
                   RenderTransformOrigin="0.5,0.5">
              <Image.RenderTransform>
                <RotateTransform Angle="-12" />
              </Image.RenderTransform>
            </Image>

            <Grid Margin="34,28,34,18">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*" />
                <ColumnDefinition Width="0.8*" />
              </Grid.ColumnDefinitions>

              <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="REBORN LAUNCHER" FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource AccentBrush}" />
                <Image Source="Assets/feather_logo.png" Width="360" HorizontalAlignment="Left"
                       Stretch="Uniform" Margin="0,16,0,0" />
                <TextBlock Text="1.8.9 · Reborn" Style="{StaticResource MutedText}"
                           Margin="0,12,0,0" />

                <Border Style="{StaticResource Card}" MaxWidth="520" HorizontalAlignment="Left" Margin="0,26,0,0">
                  <StackPanel>
                    <TextBlock Text="开始游戏" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Text="离线用户名" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                    <TextBox x:Name="UsernameBox" Margin="0,12,0,0" TextChanged="UsernameBox_TextChanged" />

                    <Grid Margin="0,16,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="内存" Style="{StaticResource MutedText}" />
                        <TextBlock x:Name="HomeMemoryText" Text="4096 MB (4 GB)" FontSize="13" Margin="0,3,0,0" />
                      </StackPanel>
                      <Button Grid.Column="1" Content="调整" Style="{StaticResource GhostButton}"
                              Click="GoSettings_Click" VerticalAlignment="Bottom" />
                    </Grid>

                    <Button x:Name="LaunchButton" Content="启动游戏" Style="{StaticResource PrimaryButton}"
                            FontSize="17" Height="54" Margin="0,18,0,0" Click="Launch_Click" />

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                      <Button Content="打开游戏目录" Style="{StaticResource GhostButton}" Click="OpenFolder_Click" />
                      <Button Content="刷新模组" Style="{StaticResource GhostButton}" Click="RefreshMods_Click" Margin="8,0,0,0" />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </StackPanel>

              <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="32,0,0,0">
                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="运行状态" FontSize="16" FontWeight="SemiBold" />
                    <Grid Margin="0,16,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="版本" Style="{StaticResource MutedText}" />
                      <TextBlock Grid.Column="1" Text="1.8.9 · Reborn" FontSize="12" />
                    </Grid>
                    <Grid Margin="0,10,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="JAR 模组" Style="{StaticResource MutedText}" />
                      <TextBlock x:Name="JarModsStatText" Grid.Column="1" Text="--" FontSize="12" />
                    </Grid>
                    <Grid Margin="0,10,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="ClickGUI 显示" Style="{StaticResource MutedText}" />
                      <TextBlock x:Name="ModulesStatText" Grid.Column="1" Text="--" FontSize="12" />
                    </Grid>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Grid>
          </Grid>

          <!-- Mods -->
          <Grid x:Name="ModsPage" Visibility="Collapsed" Margin="34,26,34,16">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel>
              <TextBlock Text="模组" FontSize="26" FontWeight="SemiBold" />
              <TextBlock Text="JAR 模组开关文件；ClickGUI 显示开关只影响模块列表。"
                         Style="{StaticResource MutedText}" Margin="0,5,0,0" />
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,18,0,12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Grid Width="300" HorizontalAlignment="Left">
                <TextBox x:Name="SearchBox" TextChanged="Search_TextChanged"
                         ToolTip="搜索模组名称或文件名" />
                <TextBlock Text="搜索模组名称或文件名" Foreground="#596273" FontSize="13"
                           Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Visibility" Value="Collapsed" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                          <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </Grid>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton x:Name="JarTab" GroupName="ModTabs" Style="{StaticResource SegmentButton}"
                             IsChecked="True" Tag="jar" Checked="ModTab_Checked" Content="JAR 模组" />
                <RadioButton x:Name="FeatherTab" GroupName="ModTabs" Style="{StaticResource SegmentButton}"
                             Tag="feather" Checked="ModTab_Checked" Content="ClickGUI 显示" />
                <Button Content="刷新" Style="{StaticResource GhostButton}" Click="RefreshMods_Click" Margin="4,0,0,0" />
              </StackPanel>
            </Grid>

            <Grid Grid.Row="2">
              <Grid x:Name="JarModsPanel">
                <Grid.RowDefinitions>
                  <RowDefinition Height="*" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <ItemsControl x:Name="JarModsList">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Style="{StaticResource RowCard}" Margin="0,0,0,8">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="42" />
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="34" Height="34" Background="#202736" CornerRadius="10">
                              <TextBlock Text="{Binding Initial}" FontSize="14" FontWeight="Bold"
                                         Foreground="#A9C7FF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                              <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Badge}" FontSize="10" Foreground="#8B93A3" Margin="8,2,0,0" />
                              </StackPanel>
                              <TextBlock Text="{Binding FileName}" Style="{StaticResource MutedText}" Margin="0,2,0,0" />
                            </StackPanel>
                            <CheckBox Grid.Column="2" Style="{StaticResource Switch}"
                                      IsChecked="{Binding Enabled, Mode=TwoWay}"
                                      IsEnabled="{Binding CanToggle}" Tag="{Binding}"
                                      AutomationProperties.Name="{Binding Name}"
                                      Click="ModToggle_Click" VerticalAlignment="Center" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
                <TextBlock x:Name="JarModsCountText" Grid.Row="1" Style="{StaticResource MutedText}" Margin="2,8,0,0" />
              </Grid>

              <Grid x:Name="FeatherModsPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                  <RowDefinition Height="*" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <ItemsControl x:Name="FeatherModulesList">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Style="{StaticResource RowCard}" Margin="0,0,0,8">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="42" />
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="34" Height="34" Background="#202736" CornerRadius="10">
                              <TextBlock Text="{Binding Initial}" FontSize="14" FontWeight="Bold"
                                         Foreground="#FF8B8D" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                              <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Badge}" FontSize="10" Foreground="#8B93A3" Margin="8,2,0,0" />
                              </StackPanel>
                              <TextBlock Text="{Binding Id}" Style="{StaticResource MutedText}" Margin="0,2,0,0" />
                            </StackPanel>
                            <CheckBox Grid.Column="2" Style="{StaticResource Switch}"
                                      IsChecked="{Binding Visible, Mode=TwoWay}" Tag="{Binding}"
                                      AutomationProperties.Name="{Binding Name}"
                                      Click="ModuleToggle_Click" VerticalAlignment="Center" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
                <TextBlock x:Name="ModulesCountText" Grid.Row="1" Style="{StaticResource MutedText}" Margin="2,8,0,0" />
              </Grid>
            </Grid>
          </Grid>

          <!-- Settings -->
          <Grid x:Name="SettingsPage" Visibility="Collapsed" Margin="34,26,34,16">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel>
              <TextBlock Text="设置" FontSize="26" FontWeight="SemiBold" />
              <TextBlock Text="设置将在下次启动生效。"
                         Style="{StaticResource MutedText}" Margin="0,5,0,0" />
            </StackPanel>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,18,0,0">
              <StackPanel MaxWidth="720" HorizontalAlignment="Left">
                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="内存" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="建议 4-8 GB。"
                               Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                    <Grid Margin="0,14,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="110" />
                      </Grid.ColumnDefinitions>
                      <Slider x:Name="MemorySlider" Minimum="1024" Maximum="16384" TickFrequency="512"
                              IsSnapToTickEnabled="True" ValueChanged="MemorySlider_ValueChanged" />
                      <TextBlock x:Name="MemoryText" Grid.Column="1" Text="4096 MB" HorizontalAlignment="Right"
                                 VerticalAlignment="Center" FontSize="13" />
                    </Grid>
                  </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                  <StackPanel>
                    <TextBlock Text="启动参数" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="额外 JVM 参数（可选）" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                    <Grid Margin="0,10,0,0">
                      <TextBox x:Name="ExtraArgsBox" />
                      <TextBlock Text="例如 -XX:+UseG1GC" Foreground="#596273" FontSize="13"
                                 Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding Text, ElementName=ExtraArgsBox}" Value="">
                                <Setter Property="Visibility" Value="Visible" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </Grid>
                    <CheckBox x:Name="KeepOpenCheck" Content="启动后保持启动器打开" Margin="0,14,0,0"
                              Style="{StaticResource DarkCheck}" />
                    <TextBlock Text="关闭启动器不会结束游戏。"
                               Style="{StaticResource MutedText}" Margin="0,6,0,0" />
                  </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                  <StackPanel>
                    <TextBlock Text="游戏目录" FontSize="16" FontWeight="SemiBold" />
                    <TextBox x:Name="GameDirBox" IsReadOnly="True" Margin="0,10,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                      <Button Content="打开目录" Style="{StaticResource GhostButton}" Click="OpenFolder_Click" />
                      <Button Content="保存设置" Style="{StaticResource PrimaryButton}" Click="SaveSettings_Click"
                              Margin="8,0,0,0" />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </Grid>

          <!-- Logs -->
          <Grid x:Name="LogsPage" Visibility="Collapsed" Margin="34,26,34,16">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid>
              <StackPanel>
                <TextBlock Text="日志" FontSize="26" FontWeight="SemiBold" />
              </StackPanel>
              <Button Content="刷新日志" Style="{StaticResource GhostButton}" HorizontalAlignment="Right"
                      VerticalAlignment="Top" Click="RefreshLogs_Click" />
            </Grid>
            <Border Style="{StaticResource Card}" Grid.Row="1" Margin="0,18,0,0" Padding="0">
              <TextBox x:Name="LogBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                       FontFamily="Consolas" FontSize="11" Background="#090C11" BorderThickness="0"
                       VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                       Foreground="#B7C0CE" Padding="14" />
            </Border>
          </Grid>
        </Grid>
      </Grid>

      <!-- Global status -->
      <Border Grid.Row="2" Background="#0E1118" BorderBrush="#1E2430" BorderThickness="0,1,0,0" Padding="18,0">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" />
          <TextBlock x:Name="GlobalStatusText" Text="就绪" FontSize="11.5" Foreground="{StaticResource MutedBrush}"
                     Margin="8,0,0,0" VerticalAlignment="Center" />
          <TextBlock Text="  ·  Feather Reborn Launcher  ·  Windows x64" FontSize="11" Foreground="#596273"
                     Margin="8,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</Window>
